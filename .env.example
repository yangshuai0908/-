# OpenAI 兼容接口地址（末尾不要带 /chat/completions，程序会自动拼）
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4      model 例：glm-4.5-air
# DeepSeek:  https://api.deepseek.com/v1               model 例：deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=
OPENAI_MODEL=glm-4.5-air

# 模型温度（测试用例设计要稳定，压低一些）
# 注意：智谱要求区间 (0,1)，不能填 0
LLM_TEMPERATURE=0.2

# 单次输出上限。不设置会把输出长度交给服务端默认值，长需求场景容易截断
LLM_MAX_TOKENS=4096

# 思考模式：disabled（默认）/ enabled
# glm-4.5-air 这类模型默认开思考，思考内容会占用 token 并显著拖慢响应；
# 「按条款设计用例」不需要长链推理，保持 disabled 即可。
# DeepSeek 等不支持该字段的服务会自动忽略，不影响兼容。
LLM_THINKING=disabled

# 后端端口
PORT=3001

# 单次生成的最大模型调用次数上限（防止长需求把额度烧穿）
MAX_LLM_CALLS=24
